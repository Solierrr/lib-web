{
  "name": "@solaria.network/web-lib",
  "version": "0.5.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "description": "Reusable React interfaces for Solierrr web applications.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Solierrr/web-lib.git"
  },
  "homepage": "https://github.com/Solierrr/web-lib#readme",
  "bugs": {
    "url": "https://github.com/Solierrr/web-lib/issues"
  },
  "keywords": [
    "solierrr",
    "react",
    "components",
    "ui"
  ],
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability.js"
    },
    "./style.css": "./dist/index.css",
    "./theme.css": "./dist/theme.css",
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/build-tokens.mjs && vite",
    "build": "node scripts/build-tokens.mjs && node scripts/build-email-branding.mjs && vite build && tsc -p tsconfig.lib.json && node scripts/package-assets.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "preview": "vite preview",
    "storybook": "node scripts/build-tokens.mjs && storybook dev -p 6006",
    "build-storybook": "node scripts/build-tokens.mjs && storybook build",
    "test:observability": "node --import ./scripts/register-ts-resolve.mjs --test \"src/observability/**/*.test.ts\""
  },
  "peerDependencies": {
    "@tabler/icons-react": "^3.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "lucide-react": "^1.49.0",
    "i18next": "^26.4.2",
    "react-email": "^6.11.1",
    "react-i18next": "^17.0.15",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "react-speech-recognition": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "^10.6.0",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/react-speech-recognition": "^3.9.6",
    "i18next": "^26.4.2",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.53.0",
    "react-email": "^6.11.1",
    "react-i18next": "^17.0.15",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "react-speech-recognition": "^4.0.1",
    "sharp": "^0.35.5",
    "tw-shimmer": "^0.4.13",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react-email": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "react-icons": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    },
    "react-speech-recognition": {
      "optional": true
    }
  }
}
