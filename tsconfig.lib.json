{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "@testing-library/jest-dom"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "declarationDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,

    "paths": {
      "@/*":  ["./src/*"],
      "@@/*": ["./src/components/*"]
    }
  },
  "include": ["src/components", "src/index.ts"]
}
